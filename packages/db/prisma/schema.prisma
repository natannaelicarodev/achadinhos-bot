// Schema do banco (PostgreSQL).
// A URL de conexão fica em prisma.config.ts (Prisma 7).
//
// Multi-tenant: todo model com `tenantId` só deve ser acessado via `forTenant(tenantId)`.
// Relações entre models com tenant usam FK composta (id, tenantId), então o banco
// impede que um registro aponte para outro de tenant diferente.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  OWNER
  MEMBER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ReportsLevel {
  BASIC
  GROUPS
  FULL
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
}

enum ChannelStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING // aguardando leitura do QR Code
  CONNECTED
  LOGGED_OUT // sessão encerrada no celular: precisa de novo QR
  ERROR
}

enum Store {
  AMAZON
  MERCADO_LIVRE
  SHOPEE
  MAGALU
  ALIEXPRESS
  OTHER
  SHEIN
}

enum OfferStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum PostStatus {
  SCHEDULED
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELED
  DISCARDED // passou do horário (fila atrasou ou janela fechou): não é enviado
  AWAITING_LINK // Mercado Livre no piloto: esperando a extensão do cliente gerar o meli.la
}

enum PostSource {
  AUTO // piloto automático
  MANUAL // botão "Enviar para meus grupos"
}

// ---------- Globais (sem tenant) ----------

model Plan {
  id                 String         @id @default(cuid())
  code               String         @unique // "starter", "pro", "agency"
  name               String
  priceCents         Int
  annualPriceCents   Int            @default(0) // preço do plano anual (cobrança da fase 9)
  currency           String         @default("BRL")
  maxWhatsappNumbers Int
  maxTelegramBots    Int
  maxGroups          Int? // null = ilimitado
  maxPostsPerDay     Int
  maxUsers           Int
  aiEnabled          Boolean
  aiCaptionsPerMonth Int? // legendas com IA por mês (fase 7); null = ilimitado
  reportsLevel       ReportsLevel
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]
}

model Tenant {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  users            User[]
  subscriptions    Subscription[]
  channels         Channel[]
  groups           Group[]
  offers           Offer[]
  posts            Post[]
  clicks           Click[]
  conversions      Conversion[]
  storeCredentials StoreCredential[]
  whatsAppSessions WhatsAppSession[]
  whatsAppKeys     WhatsAppSessionKey[]
  featureRequests  FeatureRequest[]
  favorites        Favorite[]
  messageTemplate  MessageTemplate?
  autopilot        AutopilotSettings?
  extensionTokens  ExtensionToken[]
  reportSnapshots  StoreReportSnapshot[]
}

// ---------- Auth ----------

model User {
  id                  String               @id @default(cuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String               @unique // sempre minúsculo
  name                String
  passwordHash        String
  role                UserRole             @default(MEMBER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  featureRequests     FeatureRequest[]
  extensionTokens     ExtensionToken[]

  @@unique([id, tenantId]) // alvo de FK composta (FeatureRequest)
  @@index([tenantId])
}

// Pedido de interesse num recurso futuro (ex.: "telegram"). Um voto por tenant e recurso.
model FeatureRequest {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String // quem clicou
  user      User     @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  feature   String // código do recurso (lista em packages/db/src/feature-requests.ts)
  createdAt DateTime @default(now())

  @@unique([tenantId, feature])
  @@index([feature, createdAt])
}

model Session {
  id        String   @id // SHA-256 (hex) do token do cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // SHA-256 (hex) do token enviado por e-mail
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------- Com tenant (acesso só via forTenant) ----------

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus
  trialEndsAt        DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, status])
}

model Channel {
  id                   String               @id @default(cuid())
  tenantId             String
  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                 ChannelType
  name                 String
  status               ChannelStatus        @default(DISCONNECTED)
  statusReason         String? // motivo em pt-BR exibido no painel (ex.: "Sessão encerrada no celular")
  externalId           String? // nº do WhatsApp ou @username do bot Telegram
  lastConnectedAt      DateTime?
  firstConnectedAt     DateTime? // primeira conexão (aquecimento do número: 7 dias)
  // Piloto automático por número
  autopilotPausedAt    DateTime? // pausado (por você ou após falhas seguidas): não envia
  autopilotPauseReason String? // motivo em pt-BR (faixa de aviso no painel)
  consecutiveFailures  Int                  @default(0) // posts que falharam seguidos (zera ao enviar)
  nextSendAt           DateTime? // próximo envio liberado (intervalo aleatório entre envios)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  groups               Group[]
  whatsAppSession      WhatsAppSession?
  whatsAppKeys         WhatsAppSessionKey[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([type, status])
}

// Sessão Baileys de um número: credenciais (creds) criptografadas.
// Nada de sessão em disco: o Railway apaga arquivos a cada deploy.
model WhatsAppSession {
  channelId  String   @id
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  ciphertext Bytes // AES-256-GCM do JSON (BufferJSON) das creds
  iv         Bytes
  authTag    Bytes
  keyVersion Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([channelId, tenantId]) // exigido pela relação 1:1 com FK composta
  @@index([tenantId])
}

// Chaves Signal do número (pre-key, session, sender-key, lid-mapping, ...).
// Uma linha por chave: o Baileys atualiza poucas por vez, a cada mensagem.
model WhatsAppSessionKey {
  channelId  String
  type       String // categoria do SignalDataTypeMap
  keyId      String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@id([channelId, type, keyId])
  @@index([tenantId])
}

model Group {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelId         String
  channel           Channel      @relation(fields: [channelId, tenantId], references: [id, tenantId], onDelete: Cascade)
  externalId        String // JID do WhatsApp ou chat_id do Telegram
  name              String
  active            Boolean      @default(true) // o número ainda participa do grupo
  postingEnabled    Boolean      @default(false) // marcado pelo usuário para receber posts
  canSend           Boolean      @default(true) // false se "só admins enviam" e o número não é admin
  isAdmin           Boolean      @default(false) // o número é admin do grupo (filtro padrão do painel)
  participantsCount Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  posts             Post[]
  clicks            Click[]
  conversions       Conversion[]

  @@unique([id, tenantId])
  @@unique([channelId, externalId])
  @@index([tenantId])
  @@index([tenantId, postingEnabled])
  @@index([channelId, isAdmin])
}

model Offer {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store              Store
  externalId         String? // id do produto na loja (evita oferta repetida)
  title              String
  description        String?
  url                String // link original do produto
  affiliateUrl       String? // link com tag de afiliado
  imageUrl           String?
  priceCents         Int?
  originalPriceCents Int?
  commissionCents    Int?
  couponCode         String?
  status             OfferStatus     @default(DRAFT)
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  posts              Post[]
  clicks             Click[]
  conversions        Conversion[]
  messageText        String? // mensagem pronta (template já preenchido) na hora do "Enviar para meus grupos"
  headline           String? // headline usada na mensagem (vai para os posts: não repetir no grupo)
  sendRequestedAt    DateTime? // pedido de envio ("Enviar para meus grupos")
  sendQueuedAt       DateTime? // quando o pedido virou posts na fila (não processa de novo)
  // Produto do catálogo central de onde a oferta veio ("Divulgar este produto").
  catalogProductId   String?
  catalogProduct     CatalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@unique([tenantId, catalogProductId]) // o mesmo produto do catálogo vira no máximo 1 oferta por tenant
  @@index([tenantId, status])
  @@index([tenantId, store, externalId])
}

// ---------- Catálogo central (global, SEM tenant) ----------
// Minerado pelo worker com credenciais CENTRAIS do sistema, usadas só para
// minerar. productUrl é o link limpo da loja, nunca link de afiliado.

enum CatalogCategory {
  FOOD_BEVERAGES // Alimentos e Bebidas
  BEAUTY // Beleza
  HOME_KITCHEN_DECOR // Casa, Cozinha e Decoração
  ELECTRONICS // Eletrônicos
  KIDS_BABY // Infantil e Baby
  FASHION // Moda
  PETS // Pets
  HEALTH // Saúde
  OTHER // sem categoria definida
}

model CatalogProduct {
  id                 String          @id @default(cuid())
  store              Store
  externalId         String // id do produto na loja (itemId da Shopee, ASIN da Amazon)
  title              String
  searchText         String // título minúsculo e sem acento (busca)
  imageUrl           String?
  productUrl         String // link limpo, sem tag de afiliado
  category           CatalogCategory @default(OTHER)
  priceCents         Int
  originalPriceCents Int?
  discountPct        Int? // 0 a 100
  commissionPct      Float? // ex.: 7.5 (%)
  commissionCents    Int?
  rating             Float? // 0 a 5
  soldCount          Int?
  score              Float           @default(0) // ranking: vendas, nota, desconto, comissão
  headlineKey        String? // tipo de produto da headline ("type:...", "category:..." ou "generic"), calculado ao minerar
  active             Boolean         @default(true)
  firstSeenAt        DateTime        @default(now())
  lastSeenAt         DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  favorites          Favorite[]
  offers             Offer[]

  @@unique([store, externalId])
  @@index([active, score(sort: Desc)])
  @@index([active, category, score(sort: Desc)])
  @@index([active, store, score(sort: Desc)])
  @@index([store, lastSeenAt])
  @@index([headlineKey])
}

// Favorito do catálogo: por tenant.
model Favorite {
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  catalogProductId String
  catalogProduct   CatalogProduct @relation(fields: [catalogProductId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([tenantId, catalogProductId])
  @@index([catalogProductId])
}

enum MiningRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED // minerador desligado (sem credencial central no .env)
}

// Histórico das execuções da mineração (diagnóstico).
model CatalogMiningRun {
  id          String          @id @default(cuid())
  store       Store
  status      MiningRunStatus
  fetched     Int             @default(0) // itens recebidos da loja
  upserted    Int             @default(0) // gravados (novos + atualizados)
  deactivated Int             @default(0) // marcados active=false
  message     String? // motivo do SKIPPED/FAILED (pt-BR)
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?

  @@index([store, startedAt(sort: Desc)])
}

model Post {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId           String
  offer             Offer      @relation(fields: [offerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  groupId           String
  group             Group      @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  shortCode         String     @unique // link rastreável /r/<shortCode>
  status            PostStatus @default(SCHEDULED)
  source            PostSource @default(MANUAL)
  scheduledAt       DateTime?
  expiresAt         DateTime? // depois disso é DESCARTADO (fila atrasou), nunca enviado
  sentAt            DateTime?
  attempts          Int        @default(0)
  externalMessageId String?
  error             String?
  // Cópia do que foi (ou será) enviado: histórico imutável depois de SENT.
  // Atualizar a Offer nunca altera posts antigos.
  store             Store?
  productExternalId String? // id do produto na loja (não repetir no grupo)
  messageText       String? // texto final enviado
  headline          String? // headline da mensagem (não repetir nas últimas 10 do grupo)
  affiliateUrl      String? // link usado no texto (Shopee: com subIds [tenant, grupo])
  priceCents        Int?
  imageUrl          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  clicks            Click[]

  @@unique([id, tenantId])
  @@index([tenantId, status, scheduledAt])
  @@index([groupId, store, productExternalId, createdAt])
  @@index([tenantId, sentAt])
  @@index([tenantId, groupId, sentAt]) // mensagens enviadas por grupo (taxa de cliques, fase 8)
}

// Relações opcionais com FK composta usam NoAction: o Postgres não consegue
// anular só a coluna do id (tenantId é obrigatório). Para "apagar" oferta/post
// com cliques ou conversões, arquive (status) em vez de deletar.

model Click {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer        @relation(fields: [offerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  postId      String?
  post        Post?        @relation(fields: [postId, tenantId], references: [id, tenantId], onDelete: NoAction)
  // Grupo onde o link foi clicado (cópia do grupo do post, para os relatórios por grupo)
  groupId     String?
  group       Group?       @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: NoAction)
  ipHash      String? // SHA-256 do IP + salt (sem IP cru, LGPD)
  userAgent   String?
  referer     String?
  createdAt   DateTime     @default(now())
  conversions Conversion[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([postId, ipHash, createdAt]) // repetição: mesmo IP no mesmo post conta 1 vez a cada 30 min
  @@index([tenantId, groupId, createdAt])
  @@index([tenantId, offerId, createdAt]) // relatório de cliques por oferta (fase 8)
}

model Conversion {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store
  externalOrderId String
  offerId         String?
  offer           Offer?    @relation(fields: [offerId, tenantId], references: [id, tenantId], onDelete: NoAction)
  clickId         String?
  click           Click?    @relation(fields: [clickId, tenantId], references: [id, tenantId], onDelete: NoAction)
  amountCents     Int
  commissionCents Int
  occurredAt      DateTime
  // Relatório da loja (fase 6): grupo pelos subIds do link, status e horário do clique
  groupId         String?
  group           Group?    @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: NoAction)
  status          String? // status da loja (ex.: Shopee PENDING / COMPLETED / CANCELLED)
  clickedAt       DateTime? // horário do clique que gerou a venda (a loja informa)
  updatedAt       DateTime  @default(now()) @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([tenantId, store, externalOrderId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, groupId, occurredAt])
  @@index([tenantId, offerId, occurredAt]) // ofertas que mais venderam (fase 8)
}

model StoreCredential {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store
  label             String?
  ciphertext        Bytes // AES-256-GCM do JSON das credenciais
  iv                Bytes // 12 bytes, aleatório por gravação
  authTag           Bytes // 16 bytes
  keyVersion        Int       @default(1)
  verifiedAt        DateTime? // "Sincronizado": teste real ok (Shopee) ou dados validados (demais lojas)
  lastError         String? // motivo em pt-BR do último teste que falhou
  // Piloto automático: loja pausada porque a credencial falhou ao gerar link (volta ao salvar de novo).
  autopilotPausedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, store])
}

// Modelo da mensagem de divulgação do tenant (um por tenant).
// Variáveis: {headline} {titulo} {preco_de} {preco_por} {desconto} {link}
model MessageTemplate {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  body            String
  headline        String // valor padrão de {headline} (editável em cada mensagem)
  autoHeadlines   Boolean  @default(true) // headline automática pelo tipo do produto (desligada = usa a fixa)
  customHeadlines String[] @default([]) // headlines próprias do cliente (entram no sorteio)
  updatedAt       DateTime @updatedAt
}

// Piloto automático do tenant (um por tenant). Horários no fuso America/Sao_Paulo.
model AutopilotSettings {
  tenantId                String            @id
  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled                 Boolean           @default(false)
  trackClicks             Boolean           @default(false) // "Contar cliques por grupo": mensagem leva o link /o/ (fase 8)
  weekdays                Int[]             @default([0, 1, 2, 3, 4, 5, 6]) // 0 = domingo
  windowStartMinute       Int               @default(480) // 08:00 (minutos desde 00:00)
  windowEndMinute         Int               @default(1320) // 22:00
  offersPerHour           Int               @default(2)
  // Filtros (lista vazia / null = sem filtro)
  stores                  Store[]           @default([])
  categories              CatalogCategory[] @default([])
  minDiscountPct          Int?
  minPriceCents           Int?
  maxPriceCents           Int?
  minRating               Float?
  minCommissionPct        Float?
  // Grupos que recebem (vazio = todos com "Postar neste grupo" ligado)
  groupIds                String[]          @default([])
  repeatDays              Int               @default(3) // não repetir o produto (loja + id) no grupo por N dias
  // Intervalo aleatório entre os grupos da MESMA oferta (o intervalo entre ofertas vem de offersPerHour)
  groupIntervalMinSeconds Int               @default(30)
  groupIntervalMaxSeconds Int               @default(90)
  channelDailyLimit       Int               @default(80) // máximo de MENSAGENS por número por dia (após o aquecimento)
  lastPickAt              DateTime? // último produto escolhido (ritmo de ofertas por hora)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

// Chave da extensão do cliente para o piloto automático (gerar meli.la no Chrome dele).
// Uma por usuário; o banco guarda só o SHA-256 da chave.
model ExtensionToken {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tokenHash  String    @unique
  lastSeenAt DateTime? // último "sinal de vida" da extensão (o piloto só escolhe ML se < 10 min)
  createdAt  DateTime  @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId, lastSeenAt])
}

// Último retrato do relatório de uma loja por período (ex.: Mercado Livre, 7 e 30 dias),
// lido pela extensão do cliente no painel de afiliados dele. Um por loja e período.
model StoreReportSnapshot {
  id                     String   @id @default(cuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                  Store
  rangeDays              Int // 7 ou 30
  periodStart            DateTime
  periodEnd              DateTime
  clicks                 Int
  buyers                 Int
  orders                 Int // pedidos
  units                  Int // unidades vendidas
  salesCents             Int
  notEffectiveSalesCents Int
  commissionCents        Int // ganho estimado
  fetchedAt              DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([tenantId, store, rangeDays])
}
