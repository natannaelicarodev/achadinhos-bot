# =============================================================
# Achadinhos Bot — variáveis de ambiente
# Copie este arquivo para .env (na raiz) e preencha os valores.
# NUNCA commite o arquivo .env.
# =============================================================

# Ambiente: development | production | test
NODE_ENV=development

# URL pública do painel (usada nos links de e-mail)
APP_URL="http://localhost:3000"

# --- Banco de dados (PostgreSQL do Railway, ambiente dev) ---
# Railway > projeto > serviço Postgres > aba "Variables" > DATABASE_PUBLIC_URL
DATABASE_URL="postgresql://postgres:SENHA@HOST.proxy.rlwy.net:PORTA/railway"

# --- Redis (Redis do Railway, ambiente dev) — usado pelo BullMQ ---
# Railway > projeto > serviço Redis > aba "Variables" > REDIS_PUBLIC_URL
REDIS_URL="redis://default:SENHA@HOST.proxy.rlwy.net:PORTA"

# --- Criptografia das credenciais de lojas (AES-256-GCM) ---
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde com cuidado: se perder a chave, as credenciais salvas não abrem mais.
# Use uma chave diferente em cada ambiente (dev/produção).
STORE_CREDENTIALS_KEY=""

# --- Criptografia das sessões do WhatsApp (AES-256-GCM) ---
# Chave DIFERENTE da STORE_CREDENTIALS_KEY. 32 bytes em base64 (mesmo comando acima).
# Se perder ou trocar a chave, todos os números precisam ler o QR Code de novo.
WHATSAPP_SESSION_KEY=""

# Nível de log do worker: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- E-mail (recuperação de senha) via SMTP ---
# Deixe SMTP_HOST vazio no dev: o link de recuperação aparece no terminal.
# Exemplos de provedor: Resend (smtp.resend.com), Brevo (smtp-relay.brevo.com).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Achadinhos Bot <nao-responda@seudominio.com.br>"

# --- Telegram (grammY, fase futura) ---
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=""
